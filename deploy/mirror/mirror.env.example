# Copy to /etc/nnp/mirror.env (root:root 0600); `install.sh --enable-mirror`
# fixes the mode. Read by nnp-mirror.service (systemd EnvironmentFile).
#
# The DEDICATED public mirror repo (not the code repo): the deploy key can
# write only there, and deleting and recreating it is the definitive purge.
NNP_MIRROR_REMOTE=git@github.com:mglerner/nonnewtonian-mirror.git
# Pins the deploy key made by `install.sh --mirror-key` and the github.com
# host key it recorded (compare that fingerprint with GitHub's published one).
GIT_SSH_COMMAND="ssh -i /var/lib/nnp/.ssh/mirror_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/nnp/.ssh/known_hosts -o StrictHostKeyChecking=yes"
# Optional healthchecks.io URL (period 1 day, grace 3 hours): /start, then ""
# on success or /fail. Treat as a secret (anyone holding it can fake pings).
NNP_MIRROR_PING_URL=
# Local bare repo the commits are built in (default shown).
#NNP_MIRROR_GITDIR=/var/lib/nnp/mirror.git
