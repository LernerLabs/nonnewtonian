# Caddy config for NonNewtonian Physicists. install.sh copies this to
# /etc/caddy/Caddyfile, putting NNP_ADMIN_EMAIL from /etc/nnp/nnp.env in
# place of the email placeholder below (ACME = the protocol Caddy uses to get
# Let's Encrypt certificates; this is its contact address), or dropping the
# email line if NNP_ADMIN_EMAIL is unset.
# Check on the server with:
#   sudo caddy validate --config /etc/caddy/Caddyfile
# (not run where this file was written).
#
# No access log (no `log` directive in any site block): manage/admin tokens
# are URL paths, and an access log would record them. Caddy still logs
# handler errors (every 502/504, e.g. while nnp restarts on an update) with
# the request URI and client IP, so the global `log` block below rewrites
# those fields to REDACTED. `caddy validate` is the syntax check (the
# `fields { }` form is the one every Caddy 2.x accepts); the repo test
# only greps. Confirm on the server: stop nnp, curl /manage/x, and
# `journalctl -u caddy` must not show /manage/x or your IP.
{
	email YOUR_EMAIL
	log {
		format filter {
			wrap console
			fields {
				request>uri replace REDACTED
				request>remote_ip replace REDACTED
				request>client_ip replace REDACTED
			}
		}
	}
}

nonnewtonian.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 11MB
	}
	# Photos straight from disk so they survive an app crash. Strict path
	# regex: only content-hash files, never app.db. Same exposure as the
	# app's /photos route (no approval check; unguessable 64-hex URLs).
	# photos.normalize_image only ever writes .jpg or .png.
	# Cache is 1 day, not immutable, so a takedown is not pinned in
	# browsers for a year.
	# KNOWN LIMITATION: file_server follows symlinks, and nnp owns
	# /var/lib/nnp, so a compromised app could link a photo-shaped path
	# (or a path under export/current, served below) to any file the caddy
	# user can read, e.g. Caddy's own TLS private key, and fetch it over
	# HTTPS. The regex limits URL shape, not link targets. Not prevented
	# here; the daily self-check alerts on any symlink under /var/lib/nnp.
	@photo path_regexp ^/photos/[0-9a-f]{2}/[0-9a-f]{64}\.(jpg|png)$
	handle @photo {
		root * /var/lib/nnp
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /photos/* {
		respond 404
	}
	handle_path /static/* {
		root * /opt/nnp/src/nonnewtonian/web/static
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
	# App down: serve the latest static export (LATER package) or down.html,
	# keeping the error status so the uptime prober still sees an outage.
	# If `caddy validate` rejects the status placeholder, drop the status
	# line and switch the prober to a keyword monitor (see deploy/RUNBOOK.md).
	handle_errors {
		@down expression `{err.status_code} in [502, 504]`
		handle @down {
			root * /var/lib/nnp/export/current
			# The export's links are relative to each page's directory, so a
			# directory must be served at its trailing-slash URL: send
			# /scientists to /scientists/ first (302, so nothing is cached
			# past the outage). UNVERIFIED until `caddy validate` and a drill
			# on the server (stop nnp, curl -I /scientists).
			@dir_no_slash {
				not path */
				file {path}/index.html
			}
			redir @dir_no_slash {path}/
			try_files {path} {path}/index.html /down.html
			file_server {
				status {err.status_code}
			}
		}
	}
}

www.nonnewtonian.org {
	redir https://nonnewtonian.org{uri} permanent
}

