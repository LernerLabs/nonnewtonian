# Copied to /etc/nnp/nnp.env by install.sh (root:root 0600). systemd reads
# it as root before dropping to user nnp.
NNP_DB=/var/lib/nnp/app.db
NNP_PHOTOS=/var/lib/nnp/photos
NNP_SITE_URL=https://nonnewtonian.org
# install.sh fills these two with secrets.token_urlsafe(32). SAVE BOTH IN
# YOUR PASSWORD MANAGER. The app refuses to boot if either is short or default.
NNP_SECRET_KEY=
NNP_ADMIN_TOKEN=
# Optional: ACME (Let's Encrypt) contact address; install.sh puts it into the
# Caddyfile in place of YOUR_EMAIL. Rerun install.sh after setting it.
#NNP_ADMIN_EMAIL=
# Optional email for /recover. ALL FOUR or none; a partial set refuses to boot.
#NNP_SMTP_HOST=
#NNP_SMTP_PORT=587
#NNP_SMTP_USER=
#NNP_SMTP_PASSWORD=
#NNP_MAIL_FROM=
