#!/bin/sh
# Run the `nonnewtonian` CLI on the server as user nnp, with the app's
# environment from /etc/nnp/nnp.env (root-only, so this needs sudo). Usage:
#   sudo /opt/nnp/deploy/nnp-cli migrate --db /var/lib/nnp/app.db --check
#   sudo /opt/nnp/deploy/nnp-cli migrate --db /var/lib/nnp/app.db
# Spell the path out: a "$NNP_DB" on the command line expands in YOUR shell,
# where it is not set, before this script loads nnp.env.
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "nnp-cli: run as root (sudo); it reads /etc/nnp/nnp.env" >&2
    exit 1
fi

# Load nnp.env the way systemd does instead of sourcing it as shell, so a
# value with spaces or `$` means the same here as in the app. Same limits as
# install.sh's envget: plain KEY=value or one pair of quotes around the whole
# value; NOT backslash escapes, line continuations or leading whitespace.
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        '#'*|';'*) continue ;;
        *=*) ;;
        *) continue ;;
    esac
    val=${line#*=}
    case "$val" in
        \'*\') val=${val#\'}; val=${val%\'} ;;
        \"*\") val=${val#\"}; val=${val%\"} ;;
    esac
    export "${line%%=*}=$val"
done < /etc/nnp/nnp.env
cd /var/lib/nnp
umask 027
exec runuser -u nnp -- /opt/nnp/.venv/bin/nonnewtonian "$@"
