# Copy to /etc/nnp/monitor.env (root:root 0600); `install.sh --enable-selfcheck`
# fixes the mode. Read by nnp-selfcheck.service (systemd EnvironmentFile).
#
# healthchecks.io check for the daily self-check: period 1 day, grace 3 hours.
# Success pings this URL; any failed check POSTs the reasons to URL/fail; no
# ping at all (box down) trips the alert. Treat as a secret (anyone holding it
# can fake pings).
NNP_SELFCHECK_PING_URL=https://hc-ping.com/YOUR-UUID
